{
  "name": "billawar-poster-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Billawar Association Mumbai - Poster Studio. Structured, template-driven poster creation with a protected official asset library.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@shopify/react-native-skia": "^2.11.2",
    "expo": "^57.0.22",
    "expo-asset": "^57.0.17",
    "expo-file-system": "^57.0.7",
    "expo-font": "^57.0.4",
    "expo-media-library": "^57.0.5",
    "expo-print": "^57.0.2",
    "expo-sharing": "^57.0.19",
    "expo-status-bar": "^57.0.1",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.12.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  }
}
