# AetherTrade AI configuration. Copy to `.env` (used by docker compose) and/or `backend/.env`
# (used when running the API directly). Never commit real values.

# --- Runtime ------------------------------------------------------------------------------------
# development | test | production. Production refuses insecure settings at startup.
AETHER_ENVIRONMENT=development
AETHER_LOG_LEVEL=INFO

# --- Database (TimescaleDB) ---------------------------------------------------------------------
POSTGRES_USER=aether
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=aethertrade
# Only for running the API outside docker compose (compose builds this URL itself):
AETHER_DATABASE_URL=postgresql+asyncpg://aether:change-me-local-dev-only@localhost:5432/aethertrade
AETHER_REDIS_URL=redis://localhost:6379/0

# --- Secrets (required) -------------------------------------------------------------------------
# Signing key for access tokens, at least 32 characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AETHER_JWT_SECRET=
# Fernet key(s) encrypting provider API keys at rest. Comma-separated; the first encrypts, all decrypt
# (rotation). A Fernet key is 32 random bytes, URL-safe base64. Generate with either:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   cd backend && uv run python -m app.cli generate-encryption-key
AETHER_SECRETS_ENCRYPTION_KEYS=

# --- HTTP ---------------------------------------------------------------------------------------
# Must be true whenever the site is served over HTTPS (and in production).
AETHER_COOKIE_SECURE=false
# JSON list of accepted Host headers. Production requires explicit names, e.g. ["aether.example.com"]
AETHER_TRUSTED_HOSTS=["*"]

# --- Product ------------------------------------------------------------------------------------
# Bounds for the default paper capital (simulated money only).
AETHER_PAPER_CAPITAL_MIN=50000
AETHER_PAPER_CAPITAL_MAX=100000
AETHER_PAPER_CAPITAL_DEFAULT=100000
# Development fixtures are labelled FIXTURE everywhere and are refused in production.
AETHER_ALLOW_FIXTURE_DATA=false

# --- Host ports for docker compose (bound to 127.0.0.1) -------------------------------------------
AETHER_DB_HOST_PORT=5432
AETHER_REDIS_HOST_PORT=6379
AETHER_API_HOST_PORT=8000
AETHER_WEB_HOST_PORT=3000
