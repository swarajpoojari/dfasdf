{
  "name": "aethertrade-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "AetherTrade AI research terminal (Next.js App Router).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
